{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "b-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "B.AI",
      "options": {
        "baseURL": "https://api.b.ai/v1",
        "apiKey": "{env:B_AI_API_KEY}",
        "headers": {
          "x-api-key": "{env:B_AI_API_KEY}"
        }
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "hy3": {
          "name": "HY3"
        },
        "gpt-5.2": {
          "name": "GPT 5.2"
        },
        "qwen3.8-flash": {
          "name": "Qwen3.8 Flash"
        }
      }
    }
  },
  "model": "b-ai/deepseek-v4-flash"
}
